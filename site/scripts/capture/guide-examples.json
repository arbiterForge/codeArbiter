{
  "schema": 1,
  "purpose": "Every fenced block in site/src/content/docs/guides, classified. test/content/guide-examples.test.ts reads this file.",
  "classes": {
    "capturable": "Output of a deterministic codeArbiter tool (hook, writer, scaffolder, release derivation, statusline). Must render from a capture in site/src/assets/captures; the guide holds only a capture reference, never typed output.",
    "illustrative": "A user request, model narration, or an invented example. Must carry the illustrative label in the form stated by its label entry; it is never presented as captured.",
    "input": "Text the reader types or writes: a slash command, a shell command, or a file they create or edit. It is not output and makes no claim that anything ran, so there is nothing to capture and no label to carry."
  },
  "matching": "A block is found by its page, its first non-blank line (or capture=<id> for a captured block) and its occurrence among identical first lines on that page. Line numbers are never used, so edits elsewhere on a page cannot orphan an entry.",
