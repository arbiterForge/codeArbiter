---
import ArbiterIcon, { type ArbiterIconName } from "./ArbiterIcon.astro";
import topicMap from "../data/topic-map.json";
import { academyLessons } from "../generated/academy-content";
import { lessonIdsForPage } from "../../scripts/topic-map";

interface Props {
  level: "Foundation" | "Practitioner" | "Power user" | "Reference" | "Labs" | "Academy";
  time: string;
  outcome: string;
  prerequisites?: string[];
  proof?: string;
}

const { level, time, outcome, prerequisites = [], proof } = Astro.props;
const timeLabel = time === "Lookup"
  ? "Reference lookup"
  : time === "Symptom-driven"
    ? time
    : `Read / walkthrough / ${time}`;
const iconByLevel: Record<Props["level"], ArbiterIconName> = {
  Foundation: "start",
  Practitioner: "workflow",
  "Power user": "understand",
  Reference: "reference",
  Labs: "forge",
  Academy: "forge",
};

// A guide or concept page lists the Academy lessons that practice it. The same map links each
// lesson back to this page (scripts/topic-map.ts, scripts/generate-academy.ts).
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pageId = Astro.locals.starlightRoute?.id ?? "";
const practice = lessonIdsForPage(topicMap, pageId).map((lessonId) => {
  const lesson = academyLessons.find((item) => item.id === lessonId);
  if (!lesson) throw new Error(`Topic map names unknown Academy lesson ${lessonId} for ${pageId}`);
  return { href: `${base}/academy/${lessonId.toLowerCase()}/`, label: `${lessonId.split("-")[0]}: ${lesson.guide.title}` };
});
---

<!-- One line by default (DOCS-OVERHAUL M4): level, time and outcome. Prerequisites
     and the completion check sit one click down so the page's own content leads. -->
<aside class="ca-page-context" aria-label="Page orientation">
  <p class="ca-page-context__line">
    <span class="ca-page-context__meta">
      <span class="ca-page-context__icon"><ArbiterIcon name={iconByLevel[level]} size="1rem" /></span>
      {level === "Reference" && time === "Lookup" ? timeLabel : `${level} · ${timeLabel}`}
    </span>
    <span class="ca-page-context__outcome"><strong>Outcome:</strong> {outcome}</span>
  </p>
  {
    practice.length > 0 && (
      <p class="ca-page-context__practice">
        <strong>Practice in Arbiter Academy:</strong>{" "}
        {practice.map((lesson, index) => (
          <>
            {index > 0 && " · "}
            <a href={lesson.href}>{lesson.label}</a>
          </>
        ))}
      </p>
    )
  }
  {
    (prerequisites.length > 0 || proof) && (
      <details class="ca-page-context__more">
        <summary>{prerequisites.length > 0 && proof ? "Before you start, and how you'll know it worked" : prerequisites.length > 0 ? "Before you start" : "How you'll know it worked"}</summary>
        {prerequisites.length > 0 && (
          <p><strong>Before you start:</strong> {prerequisites.join(" · ")}</p>
        )}
        {proof && (
          <p><strong>Proof of completion:</strong> {proof}</p>
        )}
      </details>
    )
  }
</aside>
