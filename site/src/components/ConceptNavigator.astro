---
import { getCollection } from 'astro:content';
import { buildConceptDirectory, conceptBackground } from '../../scripts/concept-directory';
const groups = buildConceptDirectory(await getCollection('docs'));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="ca-concept-nav not-content" aria-label="Concept map">
  {groups.map((group, index) => <section aria-labelledby={`concept-group-${group.id}`}>
    <header><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><div><h3 id={`concept-group-${group.id}`}>{group.title}</h3><p>{group.question}</p></div></header>
    <ul data-ca-layout="peers" role="list">{group.items.map(item => <li><a href={`${base}/${item.slug}/`}><strong>{item.title}</strong><span>{item.question}</span><span aria-hidden="true" class="ca-concept-nav__arrow">→</span></a></li>)}</ul>
  </section>)}
  <details><summary>Research and design history</summary><p>These pages explain the background to choices. Historical evidence does not certify a current installed release.</p><ul>{conceptBackground.map(item => <li><a href={`${base}/${item.slug}/`}>{item.title}</a></li>)}</ul></details>
</nav>
<style>
  .ca-concept-nav { display: grid; gap: var(--ca-space-6); margin-block: var(--ca-space-6); container-type: inline-size; overflow-wrap: anywhere; }
  .ca-concept-nav header { display: flex; gap: var(--ca-space-4); align-items: start; margin-block-end: var(--ca-space-3); }
  .ca-concept-nav header > span { flex-shrink: 0; padding-block-start: var(--ca-space-1); color: var(--ca-brand-bright); font: 700 var(--ca-text-sm)/1.5 var(--ca-font-mono); }
  .ca-concept-nav :is(h3,p,ul) { margin: 0; }
  .ca-concept-nav h3 { color: var(--ca-ink); font-size: var(--ca-text-xl); line-height: 1.4; }
  .ca-concept-nav p { color: var(--ca-ink-soft); font-size: var(--ca-text-sm); line-height: 1.7; }
  .ca-concept-nav ul { display: grid; grid-template-columns: minmax(0,1fr); padding: 0; list-style: none; gap: var(--ca-space-3); }
  .ca-concept-nav li { min-inline-size: 0; }
  .ca-concept-nav li > a { height: 100%; box-sizing: border-box; display: grid; grid-template-columns: minmax(0,1fr) auto; gap: var(--ca-space-2) var(--ca-space-4); padding: var(--ca-space-4); border: 1px solid var(--ca-line); border-radius: var(--ca-radius-md); text-decoration: none; background: var(--ca-bg-raised); }
  .ca-concept-nav a strong { color: var(--ca-ink); font-size: var(--ca-text-base); line-height: 1.5; }
  .ca-concept-nav a > span:not(.ca-concept-nav__arrow) { grid-column: 1; color: var(--ca-ink-soft); font-size: var(--ca-text-sm); line-height: 1.6; }
  .ca-concept-nav__arrow { color: var(--ca-brand-bright); grid-column: 2; grid-row: 1 / 3; align-self: center; }
  .ca-concept-nav a:hover { border-color: var(--ca-brand); }
  .ca-concept-nav :is(a,summary):focus-visible { outline: 2px solid var(--ca-brand-bright); outline-offset: 4px; }
  .ca-concept-nav details { border-block-start: 1px solid var(--ca-line); padding-block-start: var(--ca-space-4); }
  .ca-concept-nav summary { color: var(--ca-ink); font-weight: 650; cursor: pointer; margin-block-end: var(--ca-space-3); }
  .ca-concept-nav details ul { margin-block-start: var(--ca-space-3); }
  .ca-concept-nav details a { color: var(--ca-brand-bright); }
  @container (min-width: 36rem) { .ca-concept-nav ul { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (forced-colors: active) { .ca-concept-nav { --ca-bg-raised: Canvas; --ca-ink: CanvasText; --ca-ink-soft: CanvasText; --ca-line: CanvasText; --ca-brand: LinkText; --ca-brand-bright: LinkText; } }
  @media print { .ca-concept-nav { container-type: normal; } .ca-concept-nav details::details-content { content-visibility: visible; } .ca-concept-nav li { break-inside: avoid; } }
</style>
