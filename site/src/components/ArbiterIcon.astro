---
export type ArbiterIconName =
  | "start"
  | "workflow"
  | "operate"
  | "understand"
  | "reference"
  | "forge"
  | "gate"
  | "repository"
  | "audit"
  | "feature"
  | "fix"
  | "sprint"
  | "dependency"
  | "decision";

interface Props {
  name: ArbiterIconName;
  label?: string;
  size?: string;
  class?: string;
}

const { name, label, size = "1.5rem" } = Astro.props;
const paths: Record<ArbiterIconName, string> = {
  start:
    '<path d="M6 21V4.5"/><path d="M6 5h10.75l-2.4 3 2.4 3H6"/><circle cx="6" cy="4.5" r="1.25"/>',
  workflow:
    '<rect x="3.5" y="4" width="5.5" height="5.5" rx="1.25"/><rect x="15" y="14.5" width="5.5" height="5.5" rx="1.25"/><path d="M9 6.75h3a4 4 0 0 1 4 4v3.75m-2.25-2.25L16 14.5l2.25-2.25"/>',
  operate:
    '<path d="M3.5 12h3l1.7-4.5 3.2 9 2.2-6 1.55 3.2h5.35"/><circle cx="19.5" cy="6" r="2.25"/><path d="M19.5 4.7v1.5l1 .65"/>',
  understand:
    '<circle cx="12" cy="12" r="8.5"/><path d="m12 6.5 2.25 5.25L12 17.5l-2.25-5.75L12 6.5Z"/><path d="M6.5 12h3.25m4.5 0h3.25"/>',
  reference:
    '<path d="M5 4.5h11.5A2.5 2.5 0 0 1 19 7v12.5H7.5A2.5 2.5 0 0 1 5 17V4.5Z"/><path d="M7.5 19.5A2.5 2.5 0 0 1 10 17h9M9 8h6m-6 4h6"/>',
  forge:
    '<path d="m12 3 1.35 5.65L19 10l-5.65 1.35L12 17l-1.35-5.65L5 10l5.65-1.35L12 3Z"/><path d="m18.5 16 .55 2.45 2.45.55-2.45.55L18.5 22l-.55-2.45L15.5 19l2.45-.55.55-2.45Z"/>',
  gate:
    '<path d="M4.5 20V4h5v16m5 0V4h5v16M9.5 12h5"/><circle cx="12" cy="12" r="1.35"/>',
  repository:
    '<path d="M4.5 6.5A2.5 2.5 0 0 1 7 4h10a2.5 2.5 0 0 1 2.5 2.5v11A2.5 2.5 0 0 1 17 20H7a2.5 2.5 0 0 1-2.5-2.5v-11Z"/><path d="M8 4v16m4-11h4m-4 3h4m-4 3h3"/>',
  audit:
    '<path d="M5 4.5h10.5A2.5 2.5 0 0 1 18 7v6"/><path d="M5 4.5v15h7"/><path d="M8.5 9h6m-6 4h4"/><circle cx="16.75" cy="17" r="3.25"/><path d="m19.1 19.35 1.4 1.4"/>',
  feature:
    '<path d="M4 18V6h5v12H4Zm11-8V6h5v12h-5v-3"/><path d="M9 12h6m-2.25-2.25L15 12l-2.25 2.25"/>',
  fix:
    '<path d="M6.25 5.5a5 5 0 0 0 6.7 6.7l6.1 6.1a1.75 1.75 0 0 0 2.45-2.5l-6.1-6.05a5 5 0 0 0-6.65-6.7l3.1 3.1-2.5 2.5-3.1-3.15Z"/>',
  sprint:
    '<path d="M4 16.5 13.5 7l3.5 3.5L7.5 20H4v-3.5Z"/><path d="m14.5 5 1-2 1 2 2 .75-2 .75-1 2-1-2-2-.75 2-.75Zm3 8.5.75-1.5.75 1.5 1.5.5-1.5.5-.75 1.5-.75-1.5-1.5-.5 1.5-.5Z"/>',
  dependency:
    '<rect x="3.5" y="4" width="6.5" height="6.5" rx="1.25"/><rect x="14" y="13.5" width="6.5" height="6.5" rx="1.25"/><path d="M10 7.25h2.5a4.25 4.25 0 0 1 4.25 4.25v2m-2.25-2.25 2.25 2.25L19 11.25"/>',
  decision:
    '<path d="M5 4.5h9.5A2.5 2.5 0 0 1 17 7v13H7.5A2.5 2.5 0 0 1 5 17.5v-13Z"/><path d="M7.5 20A2.5 2.5 0 0 1 10 17.5h7M9 9l1.7 1.7L14.5 7m-5.5 7h5"/>',
};
const a11yAttrs = label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" };
---

<svg
  {...a11yAttrs}
  class:list={["ca-icon", Astro.props.class]}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.55"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={`--ca-icon-size: ${size}`}
  set:html={paths[name]}
/>

<style>
  .ca-icon {
    width: var(--ca-icon-size);
    height: var(--ca-icon-size);
    flex: none;
    overflow: visible;
  }
</style>
