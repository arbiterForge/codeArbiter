---
import { academyLessons } from "../generated/academy-content";
import { shouldRenderCommandPreferences } from "../scripts/academy-command-preferences";

interface Props {
  labId: string;
}

const { labId } = Astro.props;
const lesson = academyLessons.find((candidate) => candidate.id === labId);

if (!lesson) {
  throw new Error(`Academy lesson ${labId} is not present in the pinned Academy source.`);
}

const variants = lesson.actions.actions.flatMap((action) => action.variants);
const operatingSystems = ["windows", "macos", "linux"] as const;
const hosts = ["claude-code", "codex", "pi"] as const;
const labels = {
  windows: "Windows",
  macos: "macOS",
  linux: "Linux",
  "claude-code": "Claude Code",
  codex: "Codex",
  pi: "Pi",
};
const availableOperatingSystems = operatingSystems.filter((operatingSystem) =>
  variants.some((variant) => variant.operating_system === operatingSystem),
);
const availableHosts = hosts.filter((host) =>
  variants.some((variant) => variant.host === host),
);
const shouldRender = shouldRenderCommandPreferences(variants);
---

{
  shouldRender && (
    <ca-academy-preferences class="academy-command-preferences" hidden>
      <div class="academy-command-preferences__intro">
        <strong>Show command examples for</strong>
      </div>
      {
        availableOperatingSystems.length > 0 && (
          <div class="academy-command-preferences__group" role="group" aria-labelledby="academy-operating-system-label">
            <span class="academy-command-preferences__label" id="academy-operating-system-label">Operating system</span>
            <div>
              {availableOperatingSystems.map((operatingSystem) => (
                <button type="button" data-academy-os={operatingSystem} aria-pressed="false">{labels[operatingSystem]}</button>
              ))}
            </div>
          </div>
        )
      }
      {
        availableHosts.length > 0 && (
          <div class="academy-command-preferences__group" role="group" aria-labelledby="academy-codearbiter-host-label">
            <span class="academy-command-preferences__label" id="academy-codearbiter-host-label">CodeArbiter host</span>
            <div>
              {availableHosts.map((host) => (
                <button type="button" data-academy-host={host} aria-pressed="false">{labels[host]}</button>
              ))}
            </div>
          </div>
        )
      }
    </ca-academy-preferences>
  )
}

<script>
  import { copyCommand, readPreferences, visibleVariantIndexes } from "../scripts/academy-command-preferences";

  const OPERATING_SYSTEMS = new Set(["windows", "macos", "linux"]);
  const HOSTS = new Set(["claude-code", "codex", "pi"]);

  class AcademyCommandPreferences extends HTMLElement {
    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      const preferences = readPreferences(() => window.localStorage, OPERATING_SYSTEMS, HOSTS);
      const commandGroups = [...document.querySelectorAll<HTMLElement>("[data-academy-command-group]")];

      const refresh = () => {
        for (const group of commandGroups) {
          const variants = [...group.querySelectorAll<HTMLElement>("[data-academy-command-variant]")];
          const visible = new Set(visibleVariantIndexes(
            variants.map((variant) => ({ os: variant.dataset.os, host: variant.dataset.host })),
            preferences,
          ));
          for (const [index, variant] of variants.entries()) variant.hidden = !visible.has(index);
        }
      };
      const reflect = () => {
        for (const button of this.querySelectorAll<HTMLButtonElement>("[data-academy-os], [data-academy-host]")) {
          const value = button.dataset.academyOs ?? button.dataset.academyHost;
          const selected = button.dataset.academyOs ? preferences.os : preferences.host;
          button.setAttribute("aria-pressed", String(selected === value));
        }
      };
      const choose = (kind: "os" | "host", value: string) => {
        const allowed = kind === "os" ? OPERATING_SYSTEMS : HOSTS;
        if (!allowed.has(value)) return;
        preferences[kind] = value;
        try {
          window.localStorage.setItem(`academy-${kind}`, value);
        } catch {
          // Storage restrictions must not disable the visible filtering controls.
        }
        reflect();
        refresh();
      };

      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-academy-os]")) {
        button.addEventListener("click", () => choose("os", button.dataset.academyOs ?? ""));
      }
      for (const button of this.querySelectorAll<HTMLButtonElement>("[data-academy-host]")) {
        button.addEventListener("click", () => choose("host", button.dataset.academyHost ?? ""));
      }
      for (const button of document.querySelectorAll<HTMLButtonElement>("[data-academy-copy]")) {
        button.addEventListener("click", async () => {
          const target = document.getElementById(button.dataset.academyCopy ?? "");
          const status = button.closest<HTMLElement>(".academy-command")?.querySelector<HTMLElement>("[data-academy-copy-status]");
          if (!target) return;
          const result = await copyCommand(
            target.textContent ?? "",
            (text) => navigator.clipboard.writeText(text),
            () => {
            const range = document.createRange();
            range.selectNodeContents(target);
            const selection = document.getSelection();
            selection?.removeAllRanges();
            selection?.addRange(range);
            },
          );
          if (status) status.textContent = result === "copied"
            ? "Copied."
            : "Clipboard unavailable. Command selected; press Ctrl+C or Command+C.";
        });
      }
      reflect();
      refresh();
      this.hidden = false;
    }
  }

  if (!customElements.get("ca-academy-preferences")) {
    customElements.define("ca-academy-preferences", AcademyCommandPreferences);
  }
</script>
