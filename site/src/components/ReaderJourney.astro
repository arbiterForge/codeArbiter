---
/** A reading map of expected artifacts and user decisions, never live progress. */
interface Props {
  id: string;
  title: string;
  boundary: string;
  steps: {
    actor: string;
    title: string;
    artifact: string;
    review: string;
    href: string;
    linkLabel: string;
  }[];
}
const { id, title, boundary, steps } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
if (!/^[a-z][a-z0-9-]*$/.test(id) || steps.length !== 4) {
  throw new Error('A reader journey requires a stable ID and four ordered steps.');
}
for (const step of steps) {
  if (!step.actor || !step.title || !step.artifact || !step.review || !step.linkLabel ||
      !/^\/(?:guides|reference|getting-started)\/[a-z0-9/#-]+$/.test(step.href)) {
    throw new Error(`Incomplete reader journey step: ${id}`);
  }
}
---
<section class="ca-reader-journey not-content" aria-labelledby={`${id}-title`} data-reader-journey={id}>
  <header>
    <p class="ca-reader-journey__eyebrow">The work, from your side</p>
    <h2 id={`${id}-title`}>{title}</h2>
    <p class="ca-reader-journey__boundary">{boundary}</p>
  </header>
  <ol class="ca-reader-journey__steps" data-ca-layout="peers" role="list">
    {steps.map((step, index) => (
      <li class="ca-reader-journey__step">
        <div class="ca-reader-journey__identity">
          <span class="ca-reader-journey__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <p class="ca-reader-journey__actor">{step.actor}</p>
        </div>
        <h3>{step.title}</h3>
        <dl>
          <dt>What you get</dt><dd>{step.artifact}</dd>
          <dt>Before moving on</dt><dd>{step.review}</dd>
        </dl>
        <a href={`${base}${step.href}`}>{step.linkLabel}<span aria-hidden="true"> →</span></a>
      </li>
    ))}
  </ol>
  <p class="ca-reader-journey__note">Reading map, not a captured run or live status. Only the actual artifacts, approvals and fresh checks establish what has completed.</p>
</section>
<style>
  .ca-reader-journey {
    container-type: inline-size;
    margin-block: var(--ca-space-7);
    overflow-wrap: anywhere;
  }
  .ca-reader-journey header { margin-block-end: var(--ca-space-5); }
  .ca-reader-journey__eyebrow { color: var(--ca-brand-bright); font: 650 var(--ca-text-xs)/1.5 var(--ca-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .ca-reader-journey h2 { margin-block: var(--ca-space-2) var(--ca-space-3); }
  .ca-reader-journey__boundary { color: var(--ca-ink-soft); font-size: var(--ca-text-sm); }
  .ca-reader-journey__steps { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--ca-space-4); padding: 0; list-style: none; }
  .ca-reader-journey__step { display: flex; flex-direction: column; gap: var(--ca-space-3); padding: var(--ca-space-5); border: 1px solid var(--ca-line-strong); border-radius: var(--ca-radius-md); background: var(--ca-bg-panel); }
  .ca-reader-journey__identity { display: flex; gap: var(--ca-space-3); align-items: center; }
  .ca-reader-journey__number { color: var(--ca-brand-bright); font: 650 2.5rem/1 var(--ca-font-mono); letter-spacing: -.06em; }
  .ca-reader-journey__actor { color: var(--ca-ink-muted); font: 650 var(--ca-text-xs)/1.5 var(--ca-font-mono); }
  .ca-reader-journey h3 { font-size: var(--ca-text-lg); line-height: 1.35; }
  .ca-reader-journey dt { color: var(--ca-ink); font-size: var(--ca-text-sm); font-weight: 700; }
  .ca-reader-journey dd { margin: var(--ca-space-1) 0 var(--ca-space-3); color: var(--ca-ink-soft); font-size: var(--ca-text-sm); line-height: 1.65; }
  .ca-reader-journey__step > a { margin-block-start: auto; padding-block: var(--ca-space-2); color: var(--ca-brand-bright); font-weight: 650; font-size: var(--ca-text-sm); }
  .ca-reader-journey__note { margin-block-start: var(--ca-space-4); color: var(--ca-ink-muted); font-size: var(--ca-text-sm); }
  @container (min-width: 36rem) { .ca-reader-journey__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (forced-colors: active) { .ca-reader-journey__step { border-color: CanvasText; } }
  @media print { .ca-reader-journey { container-type: normal; } .ca-reader-journey__steps { display: block; } .ca-reader-journey__step { break-inside: avoid; margin-block-end: var(--ca-space-4); } }
</style>
