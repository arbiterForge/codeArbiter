---
/**
 * LaneRoute.astro - a lane's real route as a line of machine frames (landing lane cards).
 *
 * The stops and markup come from scripts/generator/machine-joins.ts, the same renderer the
 * generated command pages use, so the route a card shows is the route the machine model keeps:
 * the frame says what each stop is, the colour what happens there (gold waits on a gate or on
 * you, green passes, red fails first or refuses). Decorative: the card's text names the lane.
 */
import { routeLineHtml, routeStops } from '../../scripts/generator/machine-joins';

interface Props {
  /** Lane part id, such as "ca-feature". */
  lane: string;
}

const stops = routeStops(Astro.props.lane);
if (stops.length === 0) throw new Error(`LaneRoute: machine part ${Astro.props.lane} has no route`);
---

<Fragment set:html={routeLineHtml(stops)} />
