---
import { workflows } from '../../scripts/execution-maps/workflows';
import { workflowMapHref } from '../../scripts/execution-maps/locations';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<ol class="ca-workflow-directory not-content" data-ca-layout="peers" role="list" aria-label="Source-traced workflow routes">
  {workflows.map((workflow, index) => <li data-workflow-link={workflow.id}>
    <p class="ca-eyebrow"><span aria-hidden="true">{String(index + 1).padStart(2, '0')} · </span>{workflow.id === 'greenfield' || workflow.id === 'brownfield' ? 'Initialization alternative' : 'A distinct operating route'}</p>
    <h3><a href={`${base}${workflow.guide}`}>{workflow.title}</a></h3>
    <p>{workflow.summary}</p>
    <div><span class="ca-workflow-directory__label">Actual endpoint</span><p>{workflow.endpoint}</p></div>
    <p class="ca-workflow-directory__links"><a href={`${base}${workflow.guide}`}>Read the procedure</a><a data-workflow-map-link href={`${base}${workflowMapHref(workflow)}`}>Trace the route</a><a href={`${base}/diagrams/${workflow.asset}`}>Full SVG</a></p>
  </li>)}
</ol>
<style>
  .ca-workflow-directory { display:grid; grid-template-columns:minmax(0,1fr); gap:var(--ca-space-5); margin-block:var(--ca-space-6); padding:0; list-style:none; container-type:inline-size; overflow-wrap:anywhere; }
  .ca-workflow-directory > li { display:flex; flex-direction:column; gap:var(--ca-space-4); padding:var(--ca-space-5); border:1px solid var(--ca-line-strong); border-radius:var(--ca-radius-md); background:var(--ca-bg-raised); min-inline-size:0; }
  .ca-workflow-directory :is(h3,p) { margin:0; }
  .ca-workflow-directory h3 { font-size:var(--ca-text-lg); line-height:1.4; }
  .ca-workflow-directory p { font-size:var(--ca-text-sm); color:var(--ca-ink-soft); line-height:1.7; }
  .ca-workflow-directory .ca-eyebrow { color:var(--ca-brand-bright); font-size:var(--ca-text-xs); }
  .ca-workflow-directory a { color:var(--ca-brand-bright); text-underline-offset:3px; }
  .ca-workflow-directory h3 a { text-decoration:none; }
  .ca-workflow-directory a:hover { text-decoration:underline; }
  .ca-workflow-directory a:focus-visible { outline:2px solid var(--ca-brand-bright); outline-offset:4px; }
  .ca-workflow-directory > li > div { border-inline-start:2px solid var(--ca-brand); padding-inline-start:var(--ca-space-3); }
  .ca-workflow-directory__label { display:block; color:var(--ca-ink-muted); font:600 var(--ca-text-xs)/1.6 var(--ca-font-mono); margin-block-end:var(--ca-space-2); }
  .ca-workflow-directory .ca-workflow-directory__links { display:flex; flex-wrap:wrap; gap:var(--ca-space-3) var(--ca-space-5); margin-block-start:auto; padding-block-start:var(--ca-space-4); border-block-start:1px solid var(--ca-line); }
  @media (min-width:70rem) { .ca-workflow-directory { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (forced-colors:active) { .ca-workflow-directory { --ca-bg-raised:Canvas; --ca-ink-soft:CanvasText; --ca-ink-muted:CanvasText; --ca-line:CanvasText; --ca-line-strong:CanvasText; --ca-brand:CanvasText; --ca-brand-bright:LinkText; } }
  @media print { .ca-workflow-directory { display:block; container-type:normal; } .ca-workflow-directory > li { break-inside:avoid; margin-block:1rem; } }
</style>
