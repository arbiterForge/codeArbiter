{
  "name": "codearbiter-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Professional codeArbiter product documentation with source-backed generated reference.",
  "scripts": {
    "gen": "tsx scripts/gen.ts && npm run gen:diagrams && npm run audit:diagrams",
    "gen:diagrams": "tsx scripts/generate-diagrams.ts",
    "gen:readme-hero": "tsx scripts/generate-readme-hero.ts",
    "capture:proof": "tsx scripts/capture-hook-proof.ts",
    "predev": "npm run gen",
    "dev": "astro dev",
    "prebuild": "npm run gen",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run && npm run test:academy-base",
    "test:academy-base": "node scripts/test-academy-non-root-base.mjs",
    "test:academy-source": "vitest run scripts/academy-source.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "link-audit": "tsx scripts/link-audit.ts",
    "audit:diagrams": "tsx scripts/diagram-audit.ts",
    "coverage": "vitest run --coverage && npm run test:academy-base"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/starlight": "^0.41.1",
    "astro": "^7.0.3"
  },
  "optionalDependencies": {
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "4.1.9"
  }
}
