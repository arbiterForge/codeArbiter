{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codearbiter:reference:plan:0.2.0",
  "title": "codeArbiter plan reference schema 0.2.0",
  "type": "object",
  "properties": {
    "format": {
      "const": "codearbiter.artifact"
    },
    "format_version": {
      "const": "0.1.0"
    },
    "kind": {
      "const": "plan"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9-]{1,79}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "governance": {
      "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/governance"
    },
    "presentation": {
      "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/presentation"
    },
    "integrity": {
      "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/integrity"
    },
    "normative": {
      "type": "object",
      "properties": {
        "retired_symbols": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/retired"
          },
          "minItems": 0
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/baseline"
        },
        "sections": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/section"
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/source"
          },
          "minItems": 0
        },
        "spec_ref": {
          "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/spec_ref"
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/task"
          },
          "minItems": 0
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/checkpoint"
          },
          "minItems": 0
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/prerequisite"
          },
          "minItems": 0
        },
        "criterion_dispositions": {
          "type": "array",
          "items": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/criterion_disposition"
          },
          "minItems": 0
        }
      },
      "required": [
        "retired_symbols",
        "title",
        "summary",
        "baseline",
        "sections",
        "sources",
        "spec_ref",
        "tasks",
        "checkpoints",
        "prerequisites",
        "criterion_dispositions"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "tasks": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{1,79}$"
          },
          "additionalProperties": {
            "$ref": "urn:codearbiter:reference:common:0.2.0#/$defs/task_state"
          }
        },
        "prerequisites": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9-]{1,79}$"
          },
          "additionalProperties": {
            "enum": [
              "not_satisfied",
              "satisfied"
            ]
          }
        }
      },
      "required": [
        "tasks",
        "prerequisites"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "format_version",
    "kind",
    "schema_version",
    "artifact_id",
    "slug",
    "revision",
    "governance",
    "presentation",
    "integrity",
    "normative",
    "execution"
  ],
  "additionalProperties": false
}
