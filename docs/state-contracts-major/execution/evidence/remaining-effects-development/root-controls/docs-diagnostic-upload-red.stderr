 - "academy-source/**"\n      - ".gitmodules"\n      - ".github/published-tags.json"\n      - ".codearbiter/release-targets.md"\n      - ".github/workflows/docs.yml"\n      # R-05 (C-F05): the voice gate and its detector select PR validation\n      # too; validation inputs equal the push list (test_ci_impact pins it).\n      # Deploy rights still come only from the deploy job\'s main-only guard.\n      - ".github/scripts/check_site_voice.py"\n      - "core/pysrc/_sloplib.py"\n      - ".github/scripts/npm_audit_gate.py"\n      - "plugins/ca-pi/tools/src/compatibility.ts"\n      - "plugins/ca-pi/package.json"\n      - "plugins/ca-codex/.codex-plugin/plugin.json"\n      - ".github/workflows/ci.yml"\n      - ".github/scripts/validate_codex_plugin.py"\n      - "core/artifacts/internal/authority/receipt.go"\n      # Match the push producer/control input set; this grants no deploy right.\n      - ".github/scripts/site_playwright_observation.py"\n      - ".github/scripts/test_site_playwright_observation.py"\n      - ".github/scripts/major_readiness.py"\n      - ".github/scripts/major_qualification_report.py"\n      - ".github/scripts/major_native_observation.py"\n      - ".github/scripts/test_major_native_observation.py"\n      - ".github/scripts/mapped_work_observation.py"\n      - ".github/scripts/test_artifact_conformance.py"\n      - "tools/go_test_parallel.py"\n      - ".github/scripts/test_go_test_parallel.py"\n      - ".github/scripts/pages_readiness.py"\n      - ".github/scripts/_boundedproc.py"\n      - ".github/scripts/_contextverificationlib.py"\n      - ".github/scripts/_immutable_git_blobs.py"\n      - ".github/scripts/ci20_native_binding.py"\n      - "core/pysrc/_gitexec.py"\n      - ".github/major-qualification-policy.json"\n      - ".github/major-test-selections.json"\n      - ".github/integration-candidate.json"\n      - "docs/state-contracts-major/**"\n  # The release workflow pushes governance tags AFTER main\'s own docs build ran,\n  # and the site derives each host\'s latest release from those tags, so rebuild\n  # main once a release run finishes. Most release runs publish nothing; that\n  # rebuild then redeploys identical content, which is cheaper than gating deploy\n  # (build must stay unconditional). A release-triggered run never cancels a\n  # running build or deploy: see cancel-in-progress below.\n  workflow_run:\n    workflows: ["release"]\n    types: [completed]\n    branches: [main]\n  workflow_dispatch:\n    inputs:\n      qualified_core_run_id:\n        description: "Later Q03: transfer the exact Pages tar from verified same-source main readiness; no rebuild"\n        required: false\n        type: string\n\n# Least-privilege: only the deploy job needs pages/id-token:write, granted at\n# job level below. The build job - which runs on PRs, including forks - stays\n# read-only.\npermissions:\n  contents: read\n\n# One run at a time per ref; let a newer push/PR-push supersede an in-flight\n# run. Per-ref grouping keeps PR validation builds from cancelling a main\n# deploy (and each other).\nconcurrency:\n  group: pages-${{ github.ref }}\n  # A fork PR whose head branch is named main also completes a release run, so a\n  # release-triggered run waits instead of cancelling; otherwise an outside\n  # contributor could keep cancelling main\'s Pages deploy. The newest pending run\n  # still replaces an older pending one, and each newer run builds a newer main.\n  cancel-in-progress: ${{ github.event_name != \'workflow_run\' }}\n\njobs:\n  # Gate the site\'s own test suite and typecheck. The Astro build (below) does\n  # not run vitest or `tsc`, so without this job a broken site test or type\n  # error would ship silently. Runs on the same site/** + plugins/ca/** triggers\n  # as build; a red test here fails the workflow.\n  site-check:\n    if: github.event_name != \'workflow_dispatch\' || inputs.qualified_core_run_id == \'\'\n    name: Site | [Test] - Generator\n    runs-on: ubuntu-latest\n    defaults:\n      run:\n        working-directory: site\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          submodules: recursive\n          fetch-depth: 0 # release applicability validates historical manifests and proof bytes\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 22.23.4 # Astro 7.4.2 requires Node >=22.23.4\n          cache: npm\n          cache-dependency-path: site/package-lock.json\n      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0\n        with:\n          python-version: "3.14"\n      - name: Test separate Docs authority and exact Pages transfer\n        run: python -B ../.github/scripts/test_site_playwright_observation.py\n      - name: Install deps\n        run: npm ci\n      - name: Audit (CVE gate - fail on HIGH)\n        # Issue #403: nothing audited site/package-lock.json, so a known-\n        # vulnerable production dependency could build and publish to GitHub\n        # Pages with this whole workflow green. `deploy` needs this job, so a\n        # red audit blocks the publish. Same threshold as the farm and sandbox\n        # gates in ci.yml; --omit=dev scopes it to what the built site actually\n        # ships, keeping routine Astro/vitest dev advisories non-blocking.\n        # The JSON report is judged by npm_audit_gate.py, which fails on every\n        # HIGH+ finding except a GHSA recorded in site/audit-exceptions.json\n        # with a dated backstop (see security-controls.md). No pipefail: npm\n        # exits 1 whenever it reports anything, and the gate decides.\n        run: npm audit --omit=dev --json | python ../.github/scripts/npm_audit_gate.py --exceptions audit-exceptions.json --audit-level=high\n        env:\n          NPM_CONFIG_LOGLEVEL: http\n      - name: Generate release applicability\n        run: npm run gen\n      - name: Typecheck\n        run: npm run typecheck\n      - name: Enforce site/VOICE.md punctuation (issue #338)\n        # site/VOICE.md has banned the em-dash as a sentence separator in site\n        # prose since 2026-07-02, and NOTHING enforced it: _sloplib\'s scope\n        # covered repo-root docs and docs/**, never site/. 16 of the 36 authored\n        # pages violated the rule for 24 days while reviewers cited it at\n        # contributors. A rule with no gate is worse than no rule - people learn\n        # that the style docs are advisory.\n        #\n        # `deploy` needs this job, so a violation blocks the publish. Scope is\n        # AUTHORED prose only, drawn from `git ls-files` via the shared\n        # in_antislop_doc_scope: generated reference pages, the changelog\n        # pass-through, and the curated plugin mirrors are all excluded, because\n        # a finding nobody wrote and nobody can fix in place is noise.\n        #\n        # Runs from the repo root, not site/, since it audits tracked paths.\n        working-directory: .\n        run: python .github/scripts/check_site_voice.py\n      - name: Bind site coverage inputs\n        id: coverage-source\n        shell: python\n        run: |\n          import hashlib, json, os, subprocess\n          from pathlib import Path\n          paths = sorted({p for folder in ("scripts", "test") for p in Path(folder).rglob("*")\n                          if p.is_file() and not (p.suffix == ".pyc" and "__pycache__" in p.parts)}\n                         | {Path(p) for p in ("package.json", "package-lock.json", "vitest.config.ts")})\n          evidence = Path(os.environ["RUNNER_TEMP"]) / "site-coverage"\n          evidence.mkdir()\n          source = {\n              "checkout_sha": subprocess.check_output(["git", "rev-parse", "HEAD"], text=True).strip(),\n              "workflow_sha": os.environ["GITHUB_SHA"],\n              "workflow_run": os.environ["GITHUB_RUN_ID"],\n              "workflow_attempt": os.environ["GITHUB_RUN_ATTEMPT"],\n              "runner_os": os.environ["RUNNER_OS"],\n              "node_version": subprocess.check_output(["node", "--version"], text=True).strip(),\n              "command": "npm run coverage",\n              "inputs": {p.as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths},\n          }\n          (evidence / "source.json").write_text(json.dumps(source, indent=2) + "\\n", encoding="utf-8")\n      - name: Test with coverage\n        run: npm run coverage\n      - name: Retain numeric site coverage summary\n        id: coverage-summary\n        shell: python\n        run: |\n          import hashlib, json, math, os\n          from pathlib import Path\n          evidence = Path(os.environ["RUNNER_TEMP"]) / "site-coverage"\n          source = json.loads((evidence / "source.json").read_text(encoding="utf-8"))\n          paths = sorted({p for folder in ("scripts", "test") for p in Path(folder).rglob("*")\n                          if p.is_file() and not (p.suffix == ".pyc" and "__pycache__" in p.parts)}\n                         | {Path(p) for p in ("package.json", "package-lock.json", "vitest.config.ts")})\n          inputs = {p.as_posix(): hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}\n          if inputs != source["inputs"]:\n              raise SystemExit("site coverage inputs changed during the test run")\n          report = Path("coverage/coverage-summary.json").read_bytes()\n          totals = json.loads(report).get("total", {})\n          for metric in ("lines", "branches"):\n              value = totals.get(metric, {})\n              total, covered, pct = value.get("total"), value.get("covered"), value.get("pct")\n              if not (type(total) is int and total > 0 and type(covered) is int and 0 <= covered <= total\n                      and type(pct) in (int, float) and math.isfinite(pct) and 0 <= pct <= 100):\n                  raise SystemExit(f"site coverage has no complete numeric {metric} summary")\n          source["totals"] = totals\n          source["coverage_summary_sha256"] = hashlib.sha256(report).hexdigest()\n          (evidence / "coverage-summary.json").write_bytes(report)\n          (evidence / "source.json").write_text(json.dumps(source, indent=2) + "\\n", encoding="utf-8")\n          print(json.dumps(totals, indent=2))\n      - name: Upload site coverage evidence\n        if: ${{ !cancelled() }}\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: site-coverage-${{ github.sha }}\n          path: ${{ runner.temp }}/site-coverage\n          if-no-files-found: ignore\n          retention-days: 5\n\n  build:\n    if: github.event_name != \'workflow_dispatch\' || inputs.qualified_core_run_id == \'\'\n    permissions:\n      contents: read\n      actions: read\n    outputs:\n      program_candidate: ${{ steps.program-mode.outputs.active }}\n    name: Site | [Build] - Astro Pages\n    runs-on: ubuntu-latest\n    defaults:\n      run:\n        working-directory: site\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          submodules: recursive\n          fetch-depth: 0 # release applicability validates historical manifests and proof bytes\n      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0\n        with:\n          node-version: 22.23.4 # Astro 7.4.2 requires Node >=22.23.4; the action defaults to 20\n          cache: npm\n          cache-dependency-path: site/package-lock.json\n      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0\n        with:\n          python-version: "3.14"\n      - name: Identify program qualification mode\n        id: program-mode\n        run: echo "active=${{ hashFiles(\'.github/integration-candidate.json\') != \'\' }}" >> "$GITHUB_OUTPUT"\n      - name: Install deps\n        run: npm ci\n      - name: Build\n        run: npm run build # prebuild regenerates the reference from plugins/ca/**\n      - name: Link audit\n        run: npm run link-audit # post-build dangling-link gate (AC-2/AC-4)\n      - name: Record runner Chrome version\n        # Chrome is maintained by the GitHub runner image; no browser download here.\n        # The npm lockfile does not authenticate browser bytes.\n        # No exact hosted Chrome version is claimed; this log records the observed one.\n        run: google-chrome --version\n      - name: Browser component acceptance\n        run: npm run test:components\n      - name: Browser publication gate\n        id: browser-gate\n        env:\n          DOCS_PROGRAM_OBSERVE: ${{ steps.program-mode.outputs.active == \'true\' && github.event_name == \'push\' && contains(fromJSON(\'["refs/heads/main","refs/heads/major/state-contracts"]\'), github.ref) }}\n        run: |\n          if [ "$DOCS_PROGRAM_OBSERVE" = true ]; then\n            python -B ../.github/scripts/site_playwright_observation.py observe --repo .. \\\n              --browser-binary /opt/google/chrome/chrome \\\n              --output "$RUNNER_TEMP/docs-browser-observation.json"\n          else\n            npm run test:browser\n          fi\n      - name: Retain browser review evidence\n        # Preserve completed captures even if a later browser assertion fails.\n        # This does not turn a failed browser gate into a publishable build.\n        if: ${{ !cancelled() }}\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: site-browser-evidence\n          path: site/.astro/browser-evidence/\n          if-no-files-found: ignore\n          retention-days: 5\n      - name: Retain browser failure diagnostics\n        if: ${{ failure() && steps.browser-gate.outcome == \'failure\' }}\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: site-browser-failures\n          path: site/.astro/playwright/\n          if-no-files-found: ignore\n          retention-days: 3\n      - name: Upload Pages artifact\n        uses: actions/upload-pages-artifact@fc324d3547104276b827a68afc52ff2a11cc49c9 # v5.0.0\n        with:\n          path: site/dist\n\n\n      - name: Emit Docs qualification report\n        id: docs-report\n        if: steps.program-mode.outputs.active == \'true\' && github.event_name == \'push\' && contains(fromJSON(\'["refs/heads/main","refs/heads/major/state-contracts"]\'), github.ref)\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: >-\n          python -B ../.github/scripts/site_playwright_observation.py emit --repo ..\n          --observation "$RUNNER_TEMP/docs-browser-observation.json"\n          --output "$RUNNER_TEMP/docs-qualification.json"\n      - name: Upload Docs qualification report\n        if: steps.docs-report.outcome == \'success\'\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: major-docs-qualification-${{ steps.docs-report.outputs.job_id }}\n          path: ${{ runner.temp }}/docs-qualification.json\n          if-no-files-found: error\n          retention-days: 14\n          overwrite: false\n\n  deploy:\n    name: Site | [Deploy] - GitHub Pages\n    needs: [build, site-check] # never publish a build whose tests/typecheck are red\n    # Allowlisted events on main only - pull_request builds are validation-only, and\n    # a new trigger never gains deploy rights by default.\n    if: contains(fromJSON(\'["push","workflow_run","workflow_dispatch"]\'), github.event_name) && github.ref == \'refs/heads/main\' && needs.build.outputs.program_candidate != \'true\' && inputs.qualified_core_run_id == \'\'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Deploy to GitHub Pages\n        id: deployment\n        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1\n\n  # Qualification Docs completes without deployment while Core waits for it.\n  # A later explicit main dispatch verifies full readiness, stages original tar\n  # bytes, and uploads them into this run because deploy-pages is current-run only.\n  qualified-pages:\n    name: Site | [Prepare] - Qualified Pages\n    if: github.event_name == \'workflow_dispatch\' && github.ref == \'refs/heads/main\' && inputs.qualified_core_run_id != \'\'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      actions: read\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          fetch-depth: 0\n          persist-credentials: false\n      - uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0\n        with:\n          python-version: "3.14"\n      - name: Verify readiness and stage the original qualified tar\n        env:\n          GH_TOKEN: ${{ github.token }}\n          QUALIFIED_CORE_RUN_ID: ${{ inputs.qualified_core_run_id }}\n        run: >-\n          python -B .github/scripts/site_playwright_observation.py prepare-promotion\n          --source "$GITHUB_SHA" --core-run-id "$QUALIFIED_CORE_RUN_ID"\n          --output "$RUNNER_TEMP/qualified-pages"\n      - name: Upload the exact qualified Pages tar\n        # Same immutable nested uploader and tar role as upload-pages-artifact.\n        uses: actions/upload-artifact@bbbca2ddaa5d8feaa63e36b76fdaad77386f024f\n        with:\n          name: github-pages\n          path: ${{ runner.temp }}/qualified-pages/artifact.tar\n          if-no-files-found: error\n          compression-level: 0\n          overwrite: false\n          retention-days: 14\n\n      - name: Read back the exact qualified Pages transfer\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: >-\n          python -B .github/scripts/site_playwright_observation.py verify-transfer\n          --lineage "$RUNNER_TEMP/qualified-pages-lineage.json"\n          --output "$RUNNER_TEMP/qualified-pages-readback.json"\n      - name: Retain qualified Pages transfer lineage\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: qualified-pages-transfer-${{ github.run_id }}\n          path: |\n            ${{ runner.temp }}/qualified-pages-lineage.json\n            ${{ runner.temp }}/qualified-pages-readback.json\n          if-no-files-found: error\n          retention-days: 14\n          overwrite: false\n\n  deploy-qualified:\n    name: Site | [Deploy] - Qualified GitHub Pages\n    needs: qualified-pages\n    if: github.event_name == \'workflow_dispatch\' && github.ref == \'refs/heads/main\' && inputs.qualified_core_run_id != \'\'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      pages: write\n      id-token: write\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    steps:\n      - name: Deploy original qualified Pages bytes\n        id: deployment\n        uses: actions/deploy-pages@368f82528645a54fb793d4d04e342629a3f51346 # v5.0.1\n'

