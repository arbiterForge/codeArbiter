+                        or type(row["seconds"]) not in (int, float)
+                        or not math.isfinite(row["seconds"]) or row["seconds"] < 0):
+                    raise ValueError
+                actual[row["id"]] = outcomes[row["outcome"]]
+            if len(set(selected)) != len(selected) or set(actual) != set(selected):
+                raise ValueError
+            named = {}
+            for row in tests:
