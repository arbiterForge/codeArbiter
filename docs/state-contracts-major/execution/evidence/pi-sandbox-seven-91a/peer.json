 "substantive_review": {
  "closed_recipe_consumption": "build_report consumes the exact finite recipes and requires singleton cell, matching source profile, owning job and complete selector set. Existing Python/SDK/TS scope guards remain; foreign/task/installed/machine cells gain no route. validate_selections retains bounded unique schema checks; semantic checks occur at report admission.",
  "original_source_admission": "Every selected result still requires one passed outcome, exact source/tree/run, stable source, whole original zero-exit invocation, original producer, exact source manifest/payload and owning upload job. Missing/duplicate/skipped/failed outcomes and wrong source/run/profile/manifest/uploader/job/role refuse.",
  "once_only_final_authority": "Existing original unfiltered Pi coverage and Docker-required Sandbox commands, 1200-second observer timeout, source closure and job/upload roles remain. Report emission remains push/main-or-integration only with integration candidate, successful original observation and successful upload. Final reader authenticates original successful jobs/runs and exact consumed payload bytes; advisory merge status is not qualification.",
  "security": "Static recipe data and bounded admission only: no new crypto primitive, secret, dependency, egress, process/environment mutation or authorization grant.",
  "finding_reviews": [
   {
    "cell": "disposition:findings:SF01",
    "profile": "pi-tools-v1",
    "job": "Coverage union (Pi)  <os: windows-latest>",
    "payload": "major-source-inputs-pi-windows-coverage",
    "selectors": 6,
    "assessment": "Six exact cases: durable file effect through real loopback proxy and parent final enforcement, plus refusal/replay/sequence/expiry/lifecycle. Fixture tools/dialogs are not actual Pi child or whole-task qualification."
   },
   {
    "cell": "disposition:findings:SF02",
    "profile": "pi-tools-v1",
    "job": "Coverage union (Pi)  <os: windows-latest>",
    "payload": "major-source-inputs-pi-windows-coverage",
    "selectors": 5,
    "assessment": "Five exact cases: bridge/persona independence, empty/failure refusal, successful once-only retry and retired-session exclusion."
   },
   {
    "cell": "disposition:findings:SF03",
    "profile": "pi-tools-v1",
    "job": "Coverage union (Pi)  <os: windows-latest>",
    "payload": "major-source-inputs-pi-windows-coverage",
    "selectors": 6,
    "assessment": "Six exact cases: off/disposal before metrics, native hook retention, late failure isolation, and both old/new completion orders. No visible host claim."
   },
   {
    "cell": "disposition:findings:SF12",
    "profile": "pi-tools-v1",
    "job": "Coverage union (Pi)  <os: windows-latest>",
    "payload": "major-source-inputs-pi-windows-coverage",
    "selectors": 6,
    "assessment": "Six exact cases: unavailable/legacy-private compatibility matrix and synthetic exact-bound dialog guards. No production doctor, general installed approval, native/human consent or ordinary support inferred."
   },
   {
    "cell": "disposition:findings:SF08",
    "profile": "sandbox-tools-v1",
    "job": "[CHECK] | [SBX ] | Sandbox driver contract",
    "payload": "major-source-inputs-sandbox-driver",
    "selectors": 9,
    "assessment": "Nine exact cases: finite cache identity/refusal observations plus both original real Docker builder cases with distinct staging names, immutable labeled image, changed dependency rebuild, concurrent convergence and independent survivor. Actual future execution remains required."
   },
   {
    "cell": "disposition:findings:SF10",
    "profile": "sandbox-tools-v1",
    "job": "[CHECK] | [SBX ] | Sandbox driver contract",
    "payload": "major-source-inputs-sandbox-driver",
    "selectors": 4,
    "assessment": "Four exact production/injected-observation cases: unavailable discovery, cancellation-independent compensation/firewall cleanup, retained unknown references and no destruction of unobserved target. No universal cleanup/real outage claim."
   },
   {
    "cell": "disposition:findings:SF09",
    "profile": "sandbox-tools-v1",
    "job": "[CHECK] | [SBX ] | Sandbox driver contract",
    "payload": "major-source-inputs-sandbox-driver",
    "selectors": 2,
    "assessment": "Two exact cases: actual Docker overflow without timeout, independent stopped-target and running-survivor inspection, plus production stop/inspect unit control. Old unlocated map was stale; no new Docker observation."
   }
