        "func (e *Engine) workUpdate(r object) (any, error) {",
        "\tid := model.S(r[\"work_id\"])",
        "\td, before, p, err := e.readWork(id)",
        "\tif err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\tif err := e.refuseLegacyWorkOwner(); err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\texpected := model.M(r[\"expected\"])",
        "\tif model.I(expected[\"revision\"]) != d.Revision() || model.S(expected[\"model_sha256\"]) != d.Hash() {",
        "\t\treturn nil, fault.At(\"REVISION_CONFLICT\", id, p, \"selected work changed; refresh its identity before retrying\")",
        "\t}",
        "\tnext, err := d.Clone()",
        "\tif err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\tnorm, ex := next.Norm(), model.M(next.Data[\"execution\"])",
        "\tswitch model.S(r[\"action\"]) {",
        "\tcase \"set-cycle\":",
        "\t\tif _, supplied := r[\"cycle_id\"]; !supplied {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_UPDATE\", \"set-cycle needs a cycle ID or null to clear it\")",
        "\t\t}",
        "\t\tif r[\"cycle_id\"] == nil {",
        "\t\t\tdelete(norm, \"cycle_id\")",
        "\t\t} else {",
        "\t\t\tnorm[\"cycle_id\"] = r[\"cycle_id\"]",
        "\t\t}",
        "\tcase \"rename\":",
        "\t\tif title := model.S(r[\"title\"]); title != \"\" {",
        "\t\t\tnorm[\"title\"] = title",
        "\t\t} else {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_UPDATE\", \"rename needs a title\")",
        "\t\t}",
        "\tcase \"attach\":",
        "\t\tif model.S(r[\"spec_id\"]) == \"\" && model.S(r[\"plan_id\"]) == \"\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_UPDATE\", \"attach needs a spec or plan ID\")",
        "\t\t}",
        "\t\tspecID, planID := model.S(r[\"spec_id\"]), model.S(r[\"plan_id\"])",
        "\t\tif specID == \"\" {",
        "\t\t\tspecID = model.S(norm[\"spec_id\"])",
        "\t\t}",
        "\t\tif planID == \"\" {",
        "\t\t\tplanID = model.S(norm[\"plan_id\"])",
        "\t\t}",
        "\t\tif specID == \"\" && planID == \"\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_UPDATE\", \"attach needs a spec or plan ID\")",
        "\t\t}",
        "\t\tspecPath, planPath, err := e.checkWorkBinding(specID, planID)",
        "\t\tif err != nil {",
        "\t\t\treturn nil, err",
        "\t\t}",
        "\t\tnorm[\"spec_id\"], norm[\"spec_path\"], norm[\"plan_id\"], norm[\"plan_path\"] = specID, specPath, nil, nil",
        "\t\tif planID != \"\" {",
        "\t\t\tnorm[\"plan_id\"] = planID",
        "\t\t\tnorm[\"plan_path\"] = planPath",
        "\t\t}",
        "\tcase \"start\":",
        "\t\tif model.S(ex[\"state\"]) != \"queued\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_TRANSITION\", \"only queued work can start\")",
        "\t\t}",
        "\t\tex[\"state\"], ex[\"started_at\"] = \"active\", time.Now().UTC().Format(\"2006-01-02\")",
        "\tcase \"complete\":",
        "\t\tif s := model.S(ex[\"state\"]); s != \"active\" && s != \"queued\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_TRANSITION\", \"only queued or active work can record completion\")",
        "\t\t}",
        "\t\tex[\"state\"], ex[\"completed_at\"] = \"complete\", time.Now().UTC().Format(\"2006-01-02\")",
        "\tcase \"reopen\":",
        "\t\tif model.S(ex[\"state\"]) != \"complete\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_TRANSITION\", \"only completed work can reopen\")",
        "\t\t}",
        "\t\tex[\"state\"], ex[\"completed_at\"] = \"active\", nil",
        "\t\tif ex[\"started_at\"] == nil {",
        "\t\t\tex[\"started_at\"] = time.Now().UTC().Format(\"2006-01-02\")",
        "\t\t}",
        "\tcase \"archive\":",
        "\t\tif model.S(ex[\"state\"]) == \"archived\" {",
        "\t\t\treturn nil, fault.New(\"INVALID_WORK_TRANSITION\", \"work is already archived\")",
        "\t\t}",
        "\t\tex[\"state\"] = \"archived\"",
        "\tcase \"observe-delivery\":",
        "\t\trepository := model.S(r[\"repository\"])",
        "\t\tpullNumber := model.I(r[\"pull_number\"])",
        "\t\tstate := model.S(r[\"pull_state\"])",
        "\t\tobservedAt := model.S(r[\"observed_at\"])",
        "\t\tparsed, parseErr := time.Parse(\"2006-01-02T15:04:05Z\", observedAt)",
        "\t\tif !workRepositoryPattern.MatchString(repository) || pullNumber < 1 ||",
        "\t\t\t(state != \"open\" && state != \"closed\" && state != \"merged\") ||",
        "\t\t\tparseErr != nil || parsed.UTC().Format(\"2006-01-02T15:04:05Z\") != observedAt {",
        "\t\t\treturn nil, fault.New(\"INVALID_DELIVERY_OBSERVATION\", \"supply a valid GitHub PR identity, state and UTC observation time\")",
        "\t\t}",
        "\t\turl := \"https://github.com/\" + repository + \"/pull/\" + strconv.FormatInt(pullNumber, 10)",
        "\t\tex[\"delivery_observation\"] = object{\"repository\": repository, \"pull_number\": pullNumber,",
        "\t\t\t\"pull_url\": url, \"state\": state, \"observed_at\": observedAt}",
        "\tdefault:",
        "\t\treturn nil, fault.New(\"INVALID_WORK_UPDATE\", \"unknown work action\")",
        "\t}",
        "\tif action := model.S(r[\"action\"]); action == \"start\" || action == \"complete\" || action == \"reopen\" {",
        "\t\tif err := e.coordinateWorkTransition(next, model.S(r[\"operation_id\"]), action, d.Revision()); err != nil {",
        "\t\t\treturn nil, err",
        "\t\t}",
        "\t}",
        "\t// Work completion is a progress report. No operation here can manufacture",
        "\t// a passing check without recorded check evidence.",
        "\tnext.Data[\"revision\"] = d.Revision() + 1",
        "\tnext, err = render.Prepare(next.Data)",
        "\tif err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\tafter, err := render.Render(next)",
        "\tif err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\tresult := workSummary(next, p)",
        "\to, err := e.FS.Commit(model.S(r[\"operation_id\"]), e.RequestHash, []store.Edit{{Path: p, Before: before, After: after}}, result)",
        "\tif err != nil {",
        "\t\treturn nil, err",
        "\t}",
        "\treturn mutationResult(o), nil",
        "}"
      ]
    }
  ]
