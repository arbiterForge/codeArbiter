        "func PrerequisiteAssessment(d *Document, record map[string]any) map[string]any {",
        "\tid := S(record[\"id\"])",
        "\tkind := S(record[\"kind\"])",
        "\tif kind == \"\" {",
        "\t\tkind = \"unspecified\"",
        "\t}",
        "\ttasks := Strings(record[\"task_refs\"])",
        "\tscope := \"tasks\"",
        "\tif len(tasks) == 0 {",
        "\t\tscope = \"unspecified\"",
        "\t}",
        "\tex := M(d.Data[\"execution\"])",
        "\tobservation := M(M(ex[\"prerequisite_observations\"])[id])",
        "\toutcome, provenance := \"unknown\", \"none\"",
        "\tvar current any",
        "\tif observation != nil {",
        "\t\tprovenance = \"caller_reported\"",
        "\t\thash, err := PrerequisiteDefinition(record)",
        "\t\tmatches := err == nil && hash == S(observation[\"definition_sha256\"])",
        "\t\tcurrent = matches",
        "\t\tif matches {",
        "\t\t\toutcome = S(observation[\"outcome\"])",
        "\t\t}",
        "\t} else if S(M(ex[\"prerequisites\"])[id]) == \"satisfied\" {",
        "\t\t// Keep historical approval status visible without treating it as a new,",
        "\t\t// live observation or silently recertifying its source.",
        "\t\tprovenance = \"legacy_receipt_unassessed\"",
        "\t}",
        "\treturn map[string]any{",
        "\t\t\"id\": id, \"title\": record[\"title\"], \"requirement\": record[\"requirement\"],",
        "\t\t\"kind\": kind, \"scope\": scope, \"task_refs\": List(tasks...), \"outcome\": outcome,",
        "\t\t\"recorded_state\": M(ex[\"prerequisites\"])[id], \"observation\": observation,",
        "\t\t\"definition_current\": current, \"provenance\": provenance,",
        "\t\t\"needs_decision\": kind == \"decision\" && outcome == \"unknown\", \"evidence_assessed\": false,",
        "\t}",
        "}"
      ]
    },
