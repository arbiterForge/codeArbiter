 "owner_trace": [
  "_records obtains an identity-bound nonretired outline and paginated read-batch records; a changed enumeration identity refuses.",
  "current_records routes HTML to the native reader and refuses an empty current collection; Markdown returns the legacy document route instead of typed record fabrication.",
  "context_text formats current declarations/statements; npm non-root cwd becomes --prefix on a copied argv and shlex.join produces text, without command execution.",
  "_dispatch commands reads current CTX-TECH-STACK command records, optional purpose equality, and an explicit reported-not-verified note."
 ],
 "edge_assessments": {
  "01": "The commands front door lists only current command records, optionally filtered by purpose, and explicitly labels run_state as reported rather than verified. The existing validate_command_record witness, not this projection, owns record-shape validation.",
  "02": "Stored run_state is not independently refreshed or certified by the commands listing or text projection. Current-evidence joins remain owned by the existing report resolver witnesses; the listing is not a second verifier.",
  "03": "Neither shlex text projection nor commands listing executes a declaration or establishes a passing run. The original resolver assessment remains limited to its supplied authorized exact-bound observation.",
  "04": "The owner returns declared/reporting data without executing it or erasing a reported failure. The existing resolver retains responsibility for exact-current failure versus unknown classification.",
  "05": "The text projection copies argv and adds npm --prefix for a declared non-root cwd; shlex.join formats that copy. It does not select or authorize a run. Existing scoped selection witnesses retain ambiguity/source-ref/cwd guards.",
  "06": "The commands and read-text projections do not establish constraint applicability or command authority. Constraint shape and task admission remain with the existing report/selection witnesses, with their stated limits."
 },
