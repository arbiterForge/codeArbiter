{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test-owned brownfield observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "evidence_kind",
    "profile",
    "snapshot_sha256",
    "launch_inventory_complete",
    "launches",
    "observations",
    "bounds",
    "elapsed_ms",
    "task_result",
    "independent_oracle_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
    },
    "evidence_kind": {
      "enum": [
        "static",
        "synthetic_loading",
        "host_loading",
        "task_behavior"
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_name",
        "host_version",
        "package_version",
        "platform",
        "model",
        "provider",
        "package_sha256",
        "settings_sha256"
      ],
      "properties": {
        "host_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "host_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "package_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "platform": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "package_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[0-9a-f]{64}$"
        },
        "settings_sha256": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "snapshot_sha256": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[0-9a-f]{64}$"
    },
    "launch_inventory_complete": {
      "type": "boolean"
    },
    "launches": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "role",
          "assignment_id",
          "parent_assignment_id",
          "depth",
          "retry"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "role": {
            "enum": [
              "scout",
              "synthesis",
              "review",
              "task"
            ]
          },
          "assignment_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "parent_assignment_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "retry": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt_id",
          "status",
          "elapsed_ms",
          "tool_calls",
          "usage",
          "loaded_context",
          "cost"
        ],
        "properties": {
          "attempt_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "cancelled",
              "oversize"
            ]
          },
          "elapsed_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "tool_calls": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "reference",
              "input_convention",
              "input_tokens",
              "cache_read_tokens",
              "cache_write_tokens",
              "output_tokens"
            ],
            "properties": {
              "source": {
                "enum": [
                  "provider",
                  "host",
                  "unavailable"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              },
              "input_convention": {
                "enum": [
                  "includes_cache",
                  "excludes_cache",
                  "unknown"
                ]
              },
              "input_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "cache_read_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "cache_write_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "output_tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              }
            }
          },
          "loaded_context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "bytes",
              "basis",
              "reference"
            ],
            "properties": {
              "bytes": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "basis": {
                "enum": [
                  "effective_input",
                  "loader_event",
                  "self_report",
                  "unavailable"
                ]
              },
              "reference": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              }
            }
          },
          "cost": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "currency",
              "source_ref"
            ],
            "properties": {
              "amount": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^(?:0|[1-9][0-9]{0,11})(?:\\.[0-9]{1,12})?$"
              },
              "currency": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[A-Z]{3}$"
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_scout_attempts",
        "max_tokens",
        "max_tool_calls",
        "deadline_ms"
      ],
      "properties": {
        "max_scout_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000000000
        },
        "max_tool_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000000000
        },
        "deadline_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000000000000
        }
      }
    },
    "elapsed_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000000
    },
    "task_result": {
      "enum": [
        "not_run",
        "passed",
        "failed",
        "inconclusive"
      ]
    },
    "independent_oracle_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    }
  }
}
