{
  "schema": 1,
  "checks": [
    {
      "id": "broad-lane",
      "lane": "CHECK",
      "scope": "REPO",
      "contract": "Broad validation"
    },
    {
      "id": "pi-adapter",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Adapter contract",
      "reproduce": "python .github/scripts/test_pi_platform_contract.py --pi-version 0.80.10"
    },
    {
      "id": "pi-checks",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Host-independent adapter contract",
      "reproduce": "npm --prefix plugins/ca-pi/tools test"
    },
    {
      "id": "ca-surface",
      "lane": "CHECK",
      "scope": "CA",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "codex-surface",
      "lane": "CHECK",
      "scope": "CDX",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "pi-surface",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "pi-latest",
      "lane": "WATCH",
      "scope": "PI",
      "contract": "Upstream compatibility"
    },
    {
      "id": "artifact-engine",
      "lane": "CHECK",
      "scope": "CORE",
      "contract": "Structured artifact engine",
      "reproduce": "cd core/artifacts && go test -buildvcs=false ./..."
    },
    {
      "id": "artifact-browser",
      "lane": "CHECK",
      "scope": "CORE",
      "contract": "Structured artifact native Chrome qualification"
    },
    {
      "id": "hooks",
      "lane": "CHECK",
      "scope": "REPO",
      "contract": "Shared hook and context source contracts"
    },
    {
      "id": "artifact-package-cold",
      "lane": "CHECK",
      "scope": "CORE",
      "contract": "Exact-head cold package qualification"
    }
  ],
  "edges": [
    {
      "glob": "core/artifacts/**",
      "checks": ["artifact-engine", "artifact-browser", "artifact-package-cold"]
    },
    {
      "glob": "docs/artifacts/**",
      "checks": ["artifact-engine", "artifact-browser", "artifact-package-cold"]
    },
    {
      "glob": "core/surface/**",
      "checks": ["artifact-engine", "artifact-package-cold", "hooks"]
    },
    {
      "glob": "plugins/ca-pi/tools/src/**",
      "checks": ["artifact-engine", "artifact-package-cold"]
    },
    {
      "glob": "plugins/ca/tools/farm.ts",
      "checks": ["artifact-engine", "artifact-package-cold"]
    },
    {
      "glob": "plugins/ca/tools/farm.js",
      "checks": ["artifact-engine", "artifact-package-cold"]
    },
    {
      "glob": "site/src/content/docs/**",
