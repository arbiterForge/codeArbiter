    },
    {
      "glob": "site/src/curated/**",
      "checks": ["artifact-engine", "artifact-package-cold"]
    },
    {
      "glob": "site/package.json",
      "checks": ["artifact-browser"]
    },
    {
      "glob": "site/package-lock.json",
      "checks": ["artifact-browser"]
    },
    {
      "glob": "site/playwright.config.ts",
      "checks": ["artifact-browser"]
