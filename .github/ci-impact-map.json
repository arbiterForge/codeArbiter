{
  "schema": 1,
  "checks": [
    {
      "id": "broad-lane",
      "lane": "CHECK",
      "scope": "REPO",
      "contract": "Broad validation"
    },
    {
      "id": "pi-adapter",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Adapter contract",
      "reproduce": "python .github/scripts/test_pi_platform_contract.py --pi-version 0.80.10"
    },
    {
      "id": "pi-checks",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Host-independent adapter contract",
      "reproduce": "npm --prefix plugins/ca-pi/tools test"
    },
    {
      "id": "ca-surface",
      "lane": "CHECK",
      "scope": "CA",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "codex-surface",
      "lane": "CHECK",
      "scope": "CDX",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "pi-surface",
      "lane": "CHECK",
      "scope": "PI",
      "contract": "Generated surface",
      "reproduce": "python tools/build-surface.py --check"
    },
    {
      "id": "pi-latest",
      "lane": "WATCH",
      "scope": "PI",
      "contract": "Upstream compatibility"
    },
    {
      "id": "artifact-engine",
      "lane": "CHECK",
      "scope": "CORE",
      "contract": "Structured artifact engine",
      "reproduce": "cd core/artifacts && go test -buildvcs=false ./..."
    }
  ],
  "edges": [
    {
      "glob": "core/artifacts/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "docs/artifacts/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "core/surface/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "plugins/ca-pi/tools/src/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "plugins/ca/tools/farm.ts",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "plugins/ca/tools/farm.js",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "site/src/content/docs/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "site/src/curated/**",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "tools/*artifact*.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_bridge.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_authoring.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_consumers.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_conformance.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_farm.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_native.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_package.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_surface.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/scripts/test_artifact_workflow.py",
      "checks": ["artifact-engine"]
    },
    {
      "glob": ".github/requirements/artifact-conformance*",
      "checks": ["artifact-engine"]
    },
    {
      "glob": "plugins/ca-pi/**",
      "checks": ["pi-adapter", "pi-checks", "pi-latest"]
    },
    {
      "glob": "core/pysrc/**",
      "checks": ["broad-lane", "artifact-engine"]
    },
    {
      "kind": "descriptor_surface",
      "source_prefix": "core/surface/",
      "checks": {
        "claude": "ca-surface",
        "codex": "codex-surface",
        "pi": "pi-surface"
      }
    }
  ]
}
