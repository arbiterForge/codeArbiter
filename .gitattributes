# Hooks and the statusline run under bash/python on every platform — keep LF so
# they never ship with CRLF (which breaks bash shebangs and is noisy in Python).
*.sh   text eol=lf
*.py   text eol=lf
hooks/* text eol=lf

# The generated root Pi manifest is compared byte-for-byte on every host.
/package.json text eol=lf

# Pi release metadata and TypeScript/JavaScript artifacts are also checked as
# exact UTF-8/LF bytes after checkout and regeneration on every hosted OS.
plugins/ca-pi/**/*.json text eol=lf
plugins/ca-pi/**/*.js   text eol=lf
plugins/ca-pi/**/*.mjs  text eol=lf
plugins/ca-pi/**/*.ts   text eol=lf
plugins/ca-pi/**/*.txt  text eol=lf

# The markdown surface is generated (core/surface/ -> plugin trees) and verified
# by a BINARY byte-compare (tools/build-surface.py --check), so these trees must
# check out LF or the gate false-fails on Windows. Deliberately scoped: operator
# state under .codearbiter/ (audit artifacts, reports, logs) and site test
# fixtures keep their committed bytes untouched.
core/surface/** text eol=lf
plugins/**/*.md text eol=lf
docs/**/*.md    text eol=lf
/*.md           text eol=lf

# Workflows and their composite actions. Not a style preference: an editor on
# Windows that rewrites one of these wholesale turns a four-line change into a
# whole-file diff, which is what happened to ci.yml in #530 (3323 changed lines
# for 44 real insertions) and which hides the actual edit from every reviewer
# and every future `git blame`. YAML block scalars normalize line breaks when
# parsed, so the runner never noticed - nothing failed, and that is precisely
# why nothing caught it.
.github/workflows/*.yml text eol=lf
.github/actions/**/*.yml text eol=lf
